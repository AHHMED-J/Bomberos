<%#
  icono.ejs — los SVG de trazo de la maqueta, en un solo lugar.
  Se incluye pasándole { icono: 'lupa', tam: 'md' }; tam es opcional.
  Convención de docs/: svg con class="icon" y viewBox="0 0 24 24", sin
  fill, heredando el color del texto que lo rodea.
%>
<% const tamano = typeof tam === 'undefined' ? 'md' : tam; %>
