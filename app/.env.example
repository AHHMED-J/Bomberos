# Copia este archivo a .env y ajusta los valores. El .env NO se sube al repo.

# --- MySQL local ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=parte_digital

# --- Servidor ------------------------------------------------------------
PORT=3000

# --- Croquis con IA (opcional) -------------------------------------------
# Si esta variable existe, /partes/:id/croquis llama a la API de Gemini y le
# pide los elementos del croquis en JSON. Si no existe, o si la llamada
# falla, el prototipo usa un croquis SVG de ejemplo y muestra la pantalla
# "Croquis sin respuesta". Nunca escribas una llave real en .env.example.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
