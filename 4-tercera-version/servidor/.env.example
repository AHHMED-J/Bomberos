# Copia este archivo como .env (arrancar/configurar.sh lo hace por ti). El .env NUNCA va al repo.

# fijo = respuestas de ejemplo (predeterminado) · local = Whisper + Ollama en esta Mac
IA_MODO=fijo

# Clave que la app manda en la cabecera X-Clave-Local. configurar.sh genera una al azar.
CLAVE_LOCAL=

# Whisper (whisper.cpp). El servidor de Whisper escucha sólo en 127.0.0.1.
WHISPER_URL=http://127.0.0.1:8178
WHISPER_MODELO=~/.bomberos-ia/modelos/ggml-large-v3.bin

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=qwen2.5:14b

# Duración máxima de un dictado, en segundos
AUDIO_MAX_S=180

# --- MySQL (usuarios, firmas y partes). Cada quien pone los de su compu. ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bomberos_v3

# 0 = rechaza las firmas simuladas (celulares sin biometría o simulador)
MODO_PRUEBA=1
